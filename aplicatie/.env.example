# Copiază acest fișier în .env și completează valorile:  cp .env.example .env
# Generare valori sigure:
#   openssl rand -hex 24        (parolă PostgreSQL)
#   openssl rand -base64 48     (secret JWT, minimum 32 de caractere)
POSTGRES_DB=nutriscan_db
POSTGRES_USER=nutriscan_user
POSTGRES_PASSWORD=schimba_ma
# Portul PostgreSQL pe gazdă (implicit 5432); altul, ex. 5433, dacă 5432 e ocupat de alt proiect
POSTGRES_PORT=5432
JWT_SECRET=schimba_ma_cu_un_secret_de_minimum_32_de_caractere
