{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nutriscan_db;Username=nutriscan_user;Password=nutriscan_secret_password"
  },
  "OcrService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Jwt": {
    "Issuer": "NutriScanApi",
    "Audience": "NutriScanClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  }
}
