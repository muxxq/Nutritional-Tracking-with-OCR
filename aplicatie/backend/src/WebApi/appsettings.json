{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nutriscan_db;Username=nutriscan_user"
  },
  "OcrService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Jwt": {
    "Issuer": "NutriScanApi",
    "Audience": "NutriScanClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  }
}
